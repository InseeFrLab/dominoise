## --- the software ----------------------------------------------------------
## `meta$Date` is absent from DESCRIPTION: fall back on the CRAN publication
## date, then on the current year (base R only: `%||%` needs R >= 4.4).
year <- if (!is.null(meta$Date)) meta$Date else meta$`Date/Publication`
year <- if (is.null(year)) format(Sys.Date(), "%Y") else sub("-.*", "", year)

bibentry(
   bibtype = "Manual",
   title   = paste0("{dominoise}: Parsimonious Noise Perturbation for ",
                    "Magnitude Tables"),
   author  = person("Julien", "Jamme"),
   year    = year,
   note    = paste0("R package version ", meta$Version),
   url     = "https://github.com/InseeFrLab/dominoise",
   textVersion = paste0(
      "Jamme, J. (", year, "). dominoise: Parsimonious Noise Perturbation for ",
      "Magnitude Tables. R package version ", meta$Version, ". ",
      "https://github.com/InseeFrLab/dominoise"
   )
 )
